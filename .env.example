# NutriFresh AI Environment Configuration

# Application Metadata
PROJECT_NAME="NutriFresh AI - Food Spoilage Detection"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false

# Server Settings
HOST="0.0.0.0"
PORT=8000
